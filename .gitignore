# The audit log is machine state, not source. It is append-only and local.
audit/
__pycache__/
*.pyc
.DS_Store

# Raw exports, when SM-1 brings them, are encrypted and NEVER tracked.
connectors/*/raw/
*.sqlcipher
*.age
graphify-out/cache/
graphify-out/manifest.json

# Playwright, Node-side only. Never imported by Python.
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/.tmp/
