{
  "name": "safe-memory-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 8767",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 8767",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:ds": "node ../scripts/check-ds.mjs app components lib",
    "test:runtime": "playwright test -c playwright.runtime.config.ts",
    "test:pairing-runtime": "playwright test -c playwright.pairing-runtime.config.ts",
    "test:metadata-runtime": "playwright test -c playwright.metadata-runtime.config.ts",
    "test:media-runtime": "playwright test -c playwright.media-runtime.config.ts",
    "test:progressive-runtime": "playwright test -c playwright.progressive-runtime.config.ts",
    "test:knowledge-runtime": "playwright test -c playwright.knowledge-runtime.config.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.60.0"
  }
}
